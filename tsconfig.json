{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": false,
    "types": ["node"]
  },
  "include": ["*.ts", "server/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", "web", "web/dist"]
}
