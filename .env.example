# Optional: select a model available to your connected ChatGPT account.
# Defaults to gpt-6-luna when available; if that model is unavailable, TailorResume uses the first model returned by the account catalog.
# OPENAI_MODEL=gpt-6-luna

# Hosted mode uses Supabase Auth. Keep APP_MODE=local for the existing local app.
# Hosted auth is unavailable until a Supabase project is configured.
# APP_MODE=hosted
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Backend-only Supabase secret key (or legacy service_role key). Never expose this to the browser.
# SUPABASE_SECRET_KEY=your-supabase-secret-key
# PUBLIC_APP_URL=https://your-render-service.onrender.com
# Generate a private 32-byte key with: openssl rand -hex 32
# Set it only in the server environment; changing it requires key rotation before saved credentials can be read.
# AI_CREDENTIAL_ENCRYPTION_KEY=64-character-hex-value
# Optional hosted-only shared AI access; set these in Render, never in the browser or git.
# TAILORRESUME_PLATFORM_AI_API_KEY=your-openai-api-key
# TAILORRESUME_PLATFORM_AI_MODEL=model-available-to-that-api-key
# TAILORRESUME_INITIAL_AI_ACCESS_CODE=set-a-private-invitation-code
